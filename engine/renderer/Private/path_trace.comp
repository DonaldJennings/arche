#version 450
// ─────────────────────────────────────────────────────────────────────────────
// Arche Engine — path_trace.comp
// Progressive path-tracer: one dispatch adds samplesPerFrame new samples to the
// RGBA32F accumulation image.  R/G/B = sum of radiance; A = sample count.
// ─────────────────────────────────────────────────────────────────────────────
layout(local_size_x = 16, local_size_y = 16) in;

// ── Bindings ─────────────────────────────────────────────────────────────────
layout(set = 0, binding = 0, rgba32f) uniform image2D uAccumImage;

struct GpuSphere {
    vec3  center;
    float radius;
    int   matIdx;
    float _p0, _p1, _p2;
};
layout(std430, set = 0, binding = 1) readonly buffer SphereBuffer {
    GpuSphere spheres[];
} sphereBuf;

struct GpuMaterial {
    vec3  albedo;
    float fuzzOrIOR;   // metal: fuzz (0-1); dielectric: IOR (e.g. 1.5)
    int   type;        // 0=Lambertian  1=Metal  2=Dielectric
    float _p0, _p1, _p2;
};
layout(std430, set = 0, binding = 2) readonly buffer MaterialBuffer {
    GpuMaterial materials[];
} matBuf;

struct GpuBvhNode {
    vec3 aabbMin;
    int  leftOrSphereIdx;   // internal: left child;  leaf: sphere index
    vec3 aabbMax;
    int  rightIsLeaf;       // internal: right child; leaf: -1
};
layout(std430, set = 0, binding = 3) readonly buffer BvhBuffer {
    GpuBvhNode nodes[];
} bvhBuf;

// ── Push constants (128 bytes) ────────────────────────────────────────────────
layout(push_constant) uniform PC {
    vec3  cameraOrigin;  float lensRadius;    // 16 B
    vec3  lowerLeft;     float _p0;           // 16 B
    vec3  horizontal;    float _p1;           // 16 B
    vec3  vertical;      float _p2;           // 16 B
    vec3  lensU;         float _p3;           // 16 B
    vec3  lensV;         float _p4;           // 16 B
    uint  frameIndex;    uint  samplesPerFrame;
    uint  maxBounces;    uint  sphereCount;
    uint  bvhNodeCount;  uint  imageW;
    uint  imageH;        uint  _pad;          // 32 B
} pc;

// ── PCG random number generator ───────────────────────────────────────────────
uint pcgStep(inout uint s) {
    s = s * 747796405u + 2891336453u;
    uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
    return (w >> 22u) ^ w;
}
float rand(inout uint rng) { return float(pcgStep(rng)) * (1.0 / 4294967296.0); }

vec3 randInUnitSphere(inout uint rng) {
    for (int i = 0; i < 64; ++i) {
        vec3 p = 2.0 * vec3(rand(rng), rand(rng), rand(rng)) - 1.0;
        if (dot(p, p) < 1.0) return p;
    }
    return vec3(0.57735); // fallback: unit diagonal
}
vec3 randUnitVec(inout uint rng) { return normalize(randInUnitSphere(rng)); }

vec2 randInUnitDisk(inout uint rng) {
    for (int i = 0; i < 64; ++i) {
        vec2 p = 2.0 * vec2(rand(rng), rand(rng)) - 1.0;
        if (dot(p, p) < 1.0) return p;
    }
    return vec2(0.0);
}

// ── Ray-sphere intersection ───────────────────────────────────────────────────
struct Hit {
    float t;
    vec3  p;
    vec3  n;        // outward-facing normal
    int   matIdx;
    bool  frontFace;
};

bool hitSphere(int idx, vec3 ro, vec3 rd, float tMin, float tMax, out Hit h) {
    GpuSphere s = sphereBuf.spheres[idx];
    vec3  oc  = ro - s.center;
    float a   = dot(rd, rd);
    float hb  = dot(oc, rd);
    float c   = dot(oc, oc) - s.radius * s.radius;
    float disc = hb * hb - a * c;
    if (disc < 0.0) return false;
    float sq   = sqrt(disc);
    float root = (-hb - sq) / a;
    if (root < tMin || root > tMax) {
        root = (-hb + sq) / a;
        if (root < tMin || root > tMax) return false;
    }
    h.t = root;
    h.p = ro + root * rd;
    vec3 outNorm = (h.p - s.center) / s.radius;
    h.frontFace  = dot(rd, outNorm) < 0.0;
    h.n          = h.frontFace ? outNorm : -outNorm;
    h.matIdx     = s.matIdx;
    return true;
}

// ── AABB slab test ────────────────────────────────────────────────────────────
bool hitAabb(vec3 lo, vec3 hi, vec3 ro, vec3 invRd, float tMin, float tMax) {
    vec3 t0 = (lo - ro) * invRd;
    vec3 t1 = (hi - ro) * invRd;
    vec3 tN = min(t0, t1);
    vec3 tF = max(t0, t1);
    tMin = max(tMin, max(tN.x, max(tN.y, tN.z)));
    tMax = min(tMax, min(tF.x,  min(tF.y,  tF.z)));
    return tMin <= tMax;
}

// ── BVH traversal (iterative, explicit stack) ─────────────────────────────────
bool hitScene(vec3 ro, vec3 rd, float tMin, float tMax, out Hit rec) {
    bool hitAny  = false;
    float closest = tMax;
    Hit tmp;

    if (pc.bvhNodeCount == 0u) {
        // No BVH: linear scan
        for (uint i = 0u; i < pc.sphereCount; ++i) {
            if (hitSphere(int(i), ro, rd, tMin, closest, tmp)) {
                closest = tmp.t; rec = tmp; hitAny = true;
            }
        }
        return hitAny;
    }

    vec3 invRd = vec3(1.0) / rd;
    int  stack[64];
    int  top = 0;
    stack[top++] = 0; // root

    while (top > 0) {
        int nodeIdx = stack[--top];
        GpuBvhNode node = bvhBuf.nodes[nodeIdx];

        if (!hitAabb(node.aabbMin, node.aabbMax, ro, invRd, tMin, closest))
            continue;

        if (node.rightIsLeaf < 0) {
            // Leaf — test single sphere
            if (hitSphere(node.leftOrSphereIdx, ro, rd, tMin, closest, tmp)) {
                closest = tmp.t; rec = tmp; hitAny = true;
            }
        } else {
            // Internal — push children (visit closer one last for front-to-back)
            if (top < 62) {
                stack[top++] = node.leftOrSphereIdx;
                stack[top++] = node.rightIsLeaf;
            }
        }
    }
    return hitAny;
}

// ── Schlick Fresnel approximation ─────────────────────────────────────────────
float schlick(float cosTheta, float ior) {
    float r0 = (1.0 - ior) / (1.0 + ior);
    r0 *= r0;
    return r0 + (1.0 - r0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

// ── Material scatter ──────────────────────────────────────────────────────────
bool scatter(vec3 rayDir, Hit h, out vec3 atten, out vec3 scattered, inout uint rng) {
    GpuMaterial mat = matBuf.materials[h.matIdx];

    if (mat.type == 0) {
        // Lambertian
        vec3 dir = h.n + randUnitVec(rng);
        if (dot(dir, dir) < 1e-8) dir = h.n;
        scattered = dir;
        atten     = mat.albedo;
        return true;

    } else if (mat.type == 1) {
        // Metal
        vec3 refl = reflect(normalize(rayDir), h.n);
        scattered = refl + mat.fuzzOrIOR * randInUnitSphere(rng);
        atten     = mat.albedo;
        return dot(scattered, h.n) > 0.0;

    } else {
        // Dielectric (glass)
        atten = vec3(1.0);
        float ratio = h.frontFace ? (1.0 / mat.fuzzOrIOR) : mat.fuzzOrIOR;
        vec3  unit  = normalize(rayDir);
        float cosT  = min(dot(-unit, h.n), 1.0);
        float sinT  = sqrt(1.0 - cosT * cosT);
        bool  mustReflect = (ratio * sinT > 1.0) ||
                            (schlick(cosT, ratio) > rand(rng));
        scattered = mustReflect ? reflect(unit, h.n)
                                : refract(unit, h.n, ratio);
        return true;
    }
}

// ── Gradient sky ──────────────────────────────────────────────────────────────
vec3 skyColor(vec3 rd) {
    float t = 0.5 * (normalize(rd).y + 1.0);
    return mix(vec3(1.0), vec3(0.5, 0.7, 1.0), t);
}

// ── Trace one path ────────────────────────────────────────────────────────────
vec3 trace(vec3 ro, vec3 rd, inout uint rng) {
    vec3 throughput = vec3(1.0);
    for (uint b = 0u; b < pc.maxBounces; ++b) {
        Hit h;
        if (hitScene(ro, rd, 0.001, 1e30, h)) {
            vec3 atten, scattered;
            if (scatter(rd, h, atten, scattered, rng)) {
                throughput *= atten;
                ro = h.p;
                rd = scattered;
            } else {
                return vec3(0.0);
            }
        } else {
            return throughput * skyColor(rd);
        }
    }
    return vec3(0.0); // exceeded bounce limit
}

// ── Entry point ───────────────────────────────────────────────────────────────
void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(pc.imageW) || px.y >= int(pc.imageH)) return;

    // Seed: pixel coords + frame index for temporal variation
    uint rng = uint(px.x) * 1973u + uint(px.y) * 9277u + pc.frameIndex * 26699u;
    pcgStep(rng); pcgStep(rng); // warm up

    vec3 sum = vec3(0.0);
    for (uint s = 0u; s < pc.samplesPerFrame; ++s) {
        // Sub-pixel jitter; v flipped so +Y is up in world space
        float u =       (float(px.x) + rand(rng)) / float(pc.imageW);
        float v = 1.0 - (float(px.y) + rand(rng)) / float(pc.imageH);

        // Defocus-blur disk sample
        vec2 disk   = pc.lensRadius * randInUnitDisk(rng);
        vec3 offset = pc.lensU * disk.x + pc.lensV * disk.y;

        vec3 ro = pc.cameraOrigin + offset;
        vec3 rd = pc.lowerLeft + u * pc.horizontal + v * pc.vertical
                - pc.cameraOrigin - offset;

        sum += trace(ro, rd, rng);
    }

    // Accumulate (R/G/B = sum; A = sample count)
    vec4 prev = imageLoad(uAccumImage, px);
    imageStore(uAccumImage, px,
               vec4(prev.rgb + sum, prev.a + float(pc.samplesPerFrame)));
}
